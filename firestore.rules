rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidStudent(data) {
      return (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 100)) &&
             (!('nicknameLower' in data) || (data.nicknameLower is string && data.nicknameLower.size() <= 100));
    }

    // Alunos e perfis
    match /students/{studentId} {
      allow read, delete: if true;
      allow create, update: if isValidStudent(request.resource.data);
    }
    
    // Submissões diárias da turma
    match /daily_submissions/{submissionId} {
      allow read, write: if true;
    }
    
    // Questões diárias e metadados
    match /questions/{questionId} {
      allow read: if true;
      allow write: if true;
    }

    // Configurações do app (ciclo diário controlado pelo professor)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
